# Public price IDs are fine to commit. Never put secret keys in this file.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_xxx

# Stripe (AI Commerce OS live prices — replace keys, not these IDs, unless you recreate products)
STRIPE_SECRET_KEY=sk_live_or_sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_TRIAL=price_1UC3gNBEo0YzuylwRWwf8403
STRIPE_PRICE_WEEKLY=price_1UBzVMBEo0YzuylwICEff8gs
STRIPE_PRICE_PRO=price_1UBzVMBEo0YzuylwtyurR6vE
STRIPE_PRICE_LIFETIME=price_1UBzVMBEo0YzuylwxIQuqmoo

# Required to sign cookies / gift redemption. Falls back to STRIPE_WEBHOOK_SECRET if unset.
ACCESS_TOKEN_SECRET=generate-a-long-random-string

# Optional persistent store (required for Telegram alerts on Vercel)
# Local/dev uses data/store.json automatically if Turso is unset.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=xxx

# Optional override for the JSON file store
# STORE_PATH=/tmp/fundalert-store.json

# Telegram (optional — setWebhook to https://YOUR_DOMAIN/api/telegram)
TELEGRAM_BOT_TOKEN=123456:ABC

# Protects /api/cron/alerts (Vercel Cron sends Authorization: Bearer $CRON_SECRET)
CRON_SECRET=generate-a-long-random-string
